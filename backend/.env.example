# Backend settings. Copy to backend/.env. Values below are safe local defaults, not secrets.
# Docker Compose sets its own database URL and defaults; backend/.env is read for the rest
# (e.g. GROQ_API_KEY).

DATABASE_URL=postgres://nops:nops@localhost:5433/nops
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
DEMO_MODE=true
CRON_SECRET=change-me-cron-secret
# Public URL users open; https:// turns on secure cookies.
APP_ORIGIN=http://localhost:8080
PORT=8080
DB_POOL_MAX=10
# Seconds before idle DB connections close (0 = keep open; use ~20 on serverless).
DB_IDLE_TIMEOUT=0

# Only when the frontend calls the API from another domain (VITE_API_URL): its URL(s),
# comma-separated. Leave empty when /api is served or forwarded on the same domain.
CORS_ORIGINS=

# Optional "Ask" assistant (Groq). Leave GROQ_API_KEY empty to switch it off.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
