# Frontend settings. Copy to frontend/.env. Only VITE_* values are built into the app (public).

# Where /api is forwarded: the backend URL for the Vite dev server and for the frontend Vercel
# project (keeps one domain, so no CORS).
API_TARGET=http://localhost:8080

# Only if the app should call the backend directly on another domain (needs CORS_ORIGINS on the
# backend). Leave empty to use /api on the same domain.
VITE_API_URL=
